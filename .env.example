# Copy to .env for local work. On Render, set these in the dashboard instead.
APP_NAME=Marrows
APP_KEY=
APP_ENV=development

# Aiven MySQL
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
DB_PREFIX=
DB_SSL=true
DB_SSL_VERIFY=false
# Paste the Aiven CA certificate here (use \n for line breaks) and set DB_SSL_VERIFY=true to verify the server
DB_SSL_CA=

# API tokens: at least 32 random characters each, and different from each other
# php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Frontend URL allowed to call the API (comma separated, no trailing slash)
CORS_ORIGIN=http://localhost:5500

# First staff login created by the migration
ADMIN_USERNAME=marrows
ADMIN_EMAIL=staff@marrows.com
ADMIN_PASSWORD=

# Only needed to run migrations over HTTP (?key=...)
MIGRATION_KEY=
